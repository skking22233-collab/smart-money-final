{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/364339144cc44f73900e58d07bc5a362.txt",
      "destination": "/364339144cc44f73900e58d07bc5a362.txt"
    },
    {
      "source": "/article/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/category/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/page/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
